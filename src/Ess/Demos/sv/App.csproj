<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>App</RootNamespace>
    <SvPackNamespace>App.Sv</SvPackNamespace>
    <SvPackOutput>$(MSBuildProjectDirectory)/obj/SvPack/</SvPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sv/src/Sv.Host/Sv.Host.csproj" />
    <ProjectReference Include="../sv/src/Sv.Pack/Sv.Pack.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../sv/build/Sv.Pack.targets" />

</Project>
