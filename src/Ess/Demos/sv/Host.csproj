<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>{{Name}}</RootNamespace>
    <SvPackNamespace>{{Name}}.Sv</SvPackNamespace>
    <SvPackOutput>$(MSBuildProjectDirectory)/obj/SvPack/</SvPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="lib/**" />
    <ProjectReference Include="lib/sv/src/Sv.Host/Sv.Host.csproj" />
    <ProjectReference Include="lib/sv/src/Sv.Pack/Sv.Pack.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="lib/sv/build/Sv.Pack.targets" />

</Project>
