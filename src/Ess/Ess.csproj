<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ess</AssemblyName>
    <RootNamespace>Ess</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Demos\**" />
    <EmbeddedResource Include="Demos\light\*" LogicalName="demos/light/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Demos\player\*" LogicalName="demos/player/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Demos\sv\*" LogicalName="demos/sv/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Demos\ecs\README.txt" LogicalName="demos/ecs/README.txt" />
    <EmbeddedResource Include="..\..\unity\PlayerSm.plantuml" LogicalName="demos/ecs/PlayerSm.plantuml" />
    <EmbeddedResource Include="..\..\unity\EssStructProbe\*" LogicalName="demos/ecs/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
